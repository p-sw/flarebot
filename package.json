{
  "name": "flarebot",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted uptime monitoring and status pages on Cloudflare Workers.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm i18n:compile && wrangler d1 migrations apply DB --local && vite",
    "build": "pnpm i18n:compile && vite build",
    "preview": "vite preview",
    "deploy": "pnpm build && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "typecheck": "pnpm i18n:compile && wrangler types && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:lang": "node scripts/lint-lang.mjs",
    "i18n:compile": "node scripts/i18n-compile.mjs",
    "i18n:check": "node scripts/i18n-check.mjs",
    "test": "pnpm i18n:compile && vitest run --config vitest.unit.config.ts && vitest run --config vitest.workers.config.ts",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:worker": "pnpm i18n:compile && vitest run --config vitest.workers.config.ts",
    "test:coverage": "pnpm i18n:compile && vitest run --config vitest.unit.config.ts --coverage && vitest run --config vitest.workers.config.ts --coverage",
    "test:e2e": "playwright test",
    "e2e": "pnpm test:e2e",
    "brand:check": "node scripts/brand-check.mjs",
    "brand:preview": "BRAND_PREVIEW=1 playwright test e2e/preview.spec.ts",
    "check": "pnpm lint && pnpm lint:lang && pnpm i18n:check && pnpm typecheck && pnpm test",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "cf-typegen": "wrangler types",
    "eject": "node scripts/eject.mjs",
    "prepare": "lefthook install || true"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lefthook",
      "workerd"
    ]
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@hono/zod-validator": "^0.9.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.46",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "worker-mailer": "1.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@cloudflare/vite-plugin": "^1.65.0",
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@inlang/paraglide-js": "^2.29.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "drizzle-kit": "^0.31.11",
    "lefthook": "^2.2.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
